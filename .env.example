# Payrexx payment gateway (get these from your Payrexx dashboard: Settings > API & Webhooks)
# PAYREXX_INSTANCE is your Payrexx subdomain, e.g. "krakenpfm" for krakenpfm.payrexx.com
PAYREXX_INSTANCE=
# PAYREXX_API_SECRET is the API secret/key shown in your Payrexx dashboard. Keep it private.
PAYREXX_API_SECRET=
APP_URL=
GEMINI_API_KEY=
GOOGLE_REVIEW_URL=
