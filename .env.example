# Copia a .env.local (ignorado por Git). Nunca publiques secretos en el chat.
# Variables de servidor: disponibles sólo en Express. No usar prefijo VITE_.
PORT=3000
APP_URL=http://localhost:3000
PAYREXX_INSTANCE=
PAYREXX_API_SECRET=
GEMINI_API_KEY=
GOOGLE_REVIEW_URL=
# Sólo servidor: toda llamada real (incluso producción) requiere opt-in explícito.
ALLOW_EXTERNAL_INTEGRATIONS=false

# Variables públicas de navegador: se incorporan al bundle al compilar.
# En local se usa el proyecto ficticio demo-kraken-pfm y emuladores por defecto.
# Para un despliegue real: VITE_FIREBASE_MODE=production; recompilar.
VITE_FIREBASE_MODE=emulator
VITE_FIREBASE_EMULATOR_HOST=127.0.0.1
# Sólo permite siembra demo en emuladores, nunca en Firebase real.
VITE_ENABLE_DEMO_DATA=false
# Opcionales: sustituyen la configuración pública de Firebase ya importada.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_DATABASE_ID=

# Desactivado por defecto: habilitar sólo tras configurar servicios de prueba.
# Para producción configurar explícitamente los valores de la cuenta autorizada.
VITE_ENABLE_EXTERNAL_SUBMISSIONS=false
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_MAKE_LEAD_WEBHOOK_URL=
VITE_MAKE_EMAIL_WEBHOOK_URL=
# Dejar vacío para usar Express en el mismo origen. Sin fallback a producción.
VITE_API_URL=

# Backend de reservas (Firebase Admin, sólo servidor).
# Emuladores: proyecto demo-kraken-pfm y hosts loopback. Nunca mezclar demo y real.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_DATABASE_ID=
FIREBASE_AUTH_EMULATOR_HOST=
FIRESTORE_EMULATOR_HOST=
# Producción/sandbox: JSON de cuenta de servicio en secreto seguro o ADC explícito.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Clave de firma individual del webhook Payrexx; distinta de la clave API.
PAYREXX_WEBHOOK_SIGNING_KEY=
# TEST por defecto; activar LIVE sólo después de pruebas sandbox y aprobación.
PAYREXX_MODE=TEST
