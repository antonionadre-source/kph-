{
  "name": "copy-of-kraken-properties-and-facilities-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx scripts/dev.ts",
    "build": "vite build && mkdir -p dist && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "audit:images": "tsx scripts/audit-images.ts",
    "typecheck": "tsc --noEmit",
    "test:server": "node --import tsx --test tests/server.test.ts",
    "test:integrations": "node scripts/test-integrations.mjs",
    "test:forms": "node scripts/test-form-delivery.mjs",
    "test": "npm run test:integrations && npm run test:forms && npm run test:uploads && npm run test:server && npm run test:vercel && npm run test:unit",
    "build:vercel": "node scripts/build-vercel.mjs",
    "test:vercel": "node --import tsx --test tests/vercel.test.ts",
    "test:unit": "node --import tsx --test tests/navigation.test.ts tests/locales.test.ts tests/kai-calendar.test.ts tests/chat-protocol.test.ts tests/portal.test.ts tests/backend.test.ts tests/html.test.ts tests/booking-client.test.mjs tests/quote-pdf.test.ts",
    "test:rules": "node --import tsx --test tests/rules.test.ts",
    "test:uploads": "node scripts/test-uploads.mjs"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@google/genai": "^1.31.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axios": "^1.13.5",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "esbuild": "^0.28.0",
    "express": "^5.2.1",
    "firebase": "^12.14.0",
    "firebase-admin": "^14.5.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "motion": "^12.36.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "rollup-plugin-visualizer": "^7.1.1"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7",
    "tsx": {
      "esbuild": "^0.28.1"
    }
  }
}
