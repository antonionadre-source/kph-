rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function staff() { return request.auth != null && request.auth.token.get('staff',false) == true && request.auth.token.get('email_verified',false) == true; }
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function safeFile() {
      return request.resource.size > 0 && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif|heic|heif)|video/(mp4|quicktime)|application/(pdf|zip|vnd[.]openxmlformats-officedocument[.]wordprocessingml[.]document)');
    }
    match /{prefix}/{uid}/{path=**} {
      allow read: if prefix in ['solicitudes','job_applications','b2b_quotes'] && (owner(uid) || staff());
      allow create, update: if prefix in ['solicitudes','job_applications','b2b_quotes'] && owner(uid) && safeFile();
      allow delete: if prefix in ['solicitudes','job_applications','b2b_quotes'] && (owner(uid) || staff());
    }
    match /{path=**} { allow read, write: if false; }
  }
}
