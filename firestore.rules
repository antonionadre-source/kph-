rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isStaffOrAdmin() {
      return request.auth != null 
        && 'email' in request.auth.token 
        && request.auth.token.email != null
        && (
          request.auth.token.email.lower().endsWith('@krakenpfm.ch') ||
          request.auth.token.email.lower() == 'antonio.nadre@anotherstar.com' ||
          request.auth.token.email.lower() == 'kai@krakenpfm.ch'
        );
    }

    match /maintenance_requests/{requestId} {
      // Direct reads and lists are limited strictly to the owner of the request or coordinator/staff
      allow read: if request.auth != null 
        && (resource.data.userId == request.auth.uid || isStaffOrAdmin());
        
      // Create conditions enforcing ID constraints, exact fields, types, and server time
      allow create: if request.auth != null
        && requestId is string
        && requestId.size() > 0
        && requestId.size() <= 128
        && request.resource.data.id == requestId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.client is string
        && request.resource.data.client.size() >= 0
        && request.resource.data.client.size() <= 100
        && request.resource.data['service'] is string
        && request.resource.data['service'].size() >= 0
        && request.resource.data['service'].size() <= 100
        && request.resource.data['date'] is string
        && request.resource.data['date'].size() >= 0
        && request.resource.data['date'].size() <= 30
        && (request.resource.data.status == 'Draft' || request.resource.data.status == 'Pending')
        && (request.resource.data.priority == 'Low' || request.resource.data.priority == 'Medium' || request.resource.data.priority == 'High')
        && request.resource.data.amount >= 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
        
      // Update conditions reinforcing immutability, terminal locking, and field validation
      allow update: if request.auth != null
        && (
          (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) ||
          (isStaffOrAdmin() && request.resource.data.userId == resource.data.userId)
        )
        // Immutable Key Fields Check
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        // Terminal State Lock (Staff can bypass)
        && (resource.data.status != 'Completed' || isStaffOrAdmin())
        // Validation Schema
        && request.resource.data.client is string
        && request.resource.data.client.size() >= 0
        && request.resource.data.client.size() <= 100
        && request.resource.data['service'] is string
        && request.resource.data['service'].size() >= 0
        && request.resource.data['service'].size() <= 100
        && request.resource.data['date'] is string
        && request.resource.data['date'].size() >= 0
        && request.resource.data['date'].size() <= 30
        && (request.resource.data.status == 'Draft' || request.resource.data.status == 'Pending' || request.resource.data.status == 'In Progress' || request.resource.data.status == 'Completed')
        && (request.resource.data.priority == 'Low' || request.resource.data.priority == 'Medium' || request.resource.data.priority == 'High')
        && request.resource.data.amount >= 0
        && request.resource.data.amount <= 1000000;
        
      // Delete condition preventing deletion of completed records unless staff
      allow delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isStaffOrAdmin())
        && (resource.data.status != 'Completed' || isStaffOrAdmin());
    }

    match /job_applications/{applicationId} {
      // Direct reads and lists are limited to staff or applicant
      allow read: if request.auth != null 
        && (resource.data.userId == request.auth.uid || isStaffOrAdmin());

      allow create: if request.auth != null
        && applicationId is string
        && applicationId.size() > 0
        && applicationId.size() <= 128
        && request.resource.data.id == applicationId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 150
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 50
        && request.resource.data.position is string
        && request.resource.data.position.size() > 0
        && request.resource.data.position.size() <= 150
        && request.resource.data.status == 'Pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if request.auth != null
        && (
          (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid) ||
          isStaffOrAdmin()
        )
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if request.auth != null
        && (resource.data.userId == request.auth.uid || isStaffOrAdmin());
    }
  }
}
